# App
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=notes_app_user
DB_PASSWORD=your_password_here
DB_NAME=notes_app
DB_CONNECTION_LIMIT=10

# Frontend
FRONTEND_URL=http://localhost:5173

# Authentication
# The placeholder below is deliberately too short to pass validation, so the
# application refuses to start until you generate a real secret of at least
# 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me
# Access token lifetime: plain seconds, or a duration such as 30m, 12h or 7d.
JWT_EXPIRES_IN=1d
